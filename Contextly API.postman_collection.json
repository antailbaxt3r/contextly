    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.id) {",
                  "    pm.collectionVariables.set('document_id', data.id);",
                  "    console.log('document_id captured:', data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Choose a PDF, .txt, or .md file from your machine.",
                  "value": null
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            },
            "description": "Multipart upload. After clicking Send, set the 'file' field to a real file on your disk. Max size is configured by MAX_UPLOAD_BYTES (default 50 MB)."
          },
          "response": []
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Document (poll for status=ready)",
          "request": {
            "method": "GET",
            "header": [],
